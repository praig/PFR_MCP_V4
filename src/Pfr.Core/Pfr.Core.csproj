<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Shared engine used by both the CLI and the GUI:
    parsers, storage, rules, locations, credential vault,
    network tools, reporting, NIOS CSV generation, WAPI client.
    No UI code belongs here.
  -->
  <PropertyGroup>
    <RootNamespace>Pfr.Core</RootNamespace>
    <AssemblyName>Pfr.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pfr.Core.Tests" />
  </ItemGroup>

  <!--
    Explore data runs SQL against an in-memory copy of a snapshot. Microsoft.Data.Sqlite is MIT; it brings
    SQLite (public domain) as a bundled native library, so nothing is installed on the target machine.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
  </ItemGroup>

</Project>
